<view class="page">
  <view class="hero-wrap">
    <view class="hero card">
      <view class="hero-badge">AI · 宠物健康助手</view>
      <view class="hero-title">智能宠医，专业守护</view>
      <view class="hero-sub">您好！我是您的AI宠物健康助手。我基于前沿宠物医学知识为您提供初步健康评估（非专业兽医诊断）。</view>
    </view>
  </view>

  <view class="pet-section card">
    <view class="pet-section-title">选择或添加宠物</view>
    <scroll-view class="pet-bar" scroll-x>
      <view class="pet-item" wx:for="{{pets}}" wx:key="_id" data-id="{{item._id}}" bindtap="onPetTap">
        <view class="avatar">
          <image wx:if="{{item.avatarIsImage}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
          <text wx:else class="avatar-emoji">{{item.avatarText}}</text>
        </view>
        <!-- 删除模式徽标：红色圆 + 白色横线 -->
        <view wx:if="{{deleteMode}}" class="del-badge">
          <view class="del-badge-line"></view>
        </view>
        <text class="pet-name ellipsis">{{item.name}}</text>
      </view>

      <view class="pet-item" bindtap="onAddPet">
        <view class="avatar add-avatar">
          <text class="plus">+</text>
        </view>
        <text class="pet-name">添加</text>
      </view>

      <view class="pet-item" bindtap="onDeletePet">
        <view class="avatar add-avatar {{deleteMode ? 'del-avatar' : ''}}">
          <text class="plus {{deleteMode ? 'del-plus' : ''}}">{{deleteMode ? '✓' : '−'}}</text>
        </view>
        <text class="pet-name">{{deleteMode ? '完成' : '删除'}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="consult-actions">
    <button class="btn-photo" bindtap="onSymptomForm">
      <view class="btn-emoji">📷</view>
      <view class="btn-label">症状拍照</view>
      <view class="btn-label">问诊</view>
    </button>
    <button class="btn-text" bindtap="onTextConsult">
      <view class="btn-emoji">💬</view>
      <view class="btn-label">文字问诊</view>
    </button>
  </view>

  <view class="firstaid-entry" bindtap="onFirstAid">
    <view class="fa-icon">⛑</view>
    <view class="fa-body">
      <view class="fa-title">宠物急救指南</view>
      <view class="fa-sub">海姆立克 · 中毒急救 · 外伤包扎</view>
    </view>
    <text class="fa-badge">离线可用</text>
    <text class="fa-arrow">›</text>
  </view>

  <view class="intro">
    <view class="tip-card card" wx:for="{{tips}}" wx:key="title">
      <view class="tip-icon">{{item.icon}}</view>
      <view class="tip-body">
        <view class="tip-title">{{item.title}}</view>
        <view class="tip-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="disclaimer">在线咨询不能替代执业兽医的现场诊断，紧急情况请立即就医。</view>
  </view>
</view>
