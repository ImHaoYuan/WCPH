.page {
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #6C8CFF 0%, #9B7BFF 100%);
  padding: 48rpx 32rpx 72rpx;
}

.user {
  display: flex;
  align-items: center;
}

.u-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.u-avatar.guest {
  background: #E4E6EC;
}

.u-img {
  width: 100%;
  height: 100%;
}

.u-emoji {
  font-size: 60rpx;
  line-height: 1;
}

.u-info {
  flex: 1;
  margin-left: 24rpx;
  color: #fff;
  min-width: 0;
}

.u-name {
  font-size: 36rpx;
  font-weight: 700;
}

.u-desc {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.u-arrow {
  color: rgba(255, 255, 255, 0.8);
  font-size: 40rpx;
}

.section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.section:first-of-type {
  margin-top: -40rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.sec-more {
  font-size: 26rpx;
  color: var(--primary);
}

.pet-card,
.rec-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.p-avatar,
.r-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 92rpx;
}

.r-avatar {
  font-size: 44rpx;
}

.p-img {
  width: 100%;
  height: 100%;
}

.p-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.p-info,
.r-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.p-name,
.r-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.p-desc,
.r-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.p-arrow,
.r-arrow {
  color: var(--text-light);
  font-size: 38rpx;
  margin-left: 12rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.logout {
  margin: 48rpx 32rpx 0;
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.8;
  box-shadow: var(--shadow);
}

.logout::after {
  border: none;
}

.bottom-space {
  height: 60rpx;
}
