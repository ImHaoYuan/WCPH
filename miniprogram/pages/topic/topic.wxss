.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(30, 40, 80, 0.05);
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B2F3A;
  margin-bottom: 16rpx;
}

.kinds {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.kind {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #F2F3F7;
  color: #5C6272;
  font-size: 26rpx;
}

.kind.on {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-weight: 600;
}

.title-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #F7F8FB;
  font-size: 27rpx;
  margin-bottom: 28rpx;
}

.excerpt {
  width: 100%;
  height: 220rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #F7F8FB;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #B0B6C3;
  margin-top: 10rpx;
}

.ph {
  color: #B0B6C3;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2B2F3A;
  margin-bottom: 12rpx;
}

.notice-line {
  font-size: 23rpx;
  color: #8A90A0;
  line-height: 1.8;
}

.submit {
  margin-top: 12rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.submit::after {
  border: none;
}

.submit.disabled {
  opacity: 0.6;
}
