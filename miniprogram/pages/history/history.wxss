.page {
  min-height: 100vh;
  padding: 24rpx;
}

.clear-row {
  text-align: right;
  margin-bottom: 20rpx;
}

.clear-link {
  font-size: 26rpx;
  color: var(--danger);
}

.rec-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.r-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex: 0 0 92rpx;
}

.r-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.r-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.r-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.r-arrow {
  color: var(--text-light);
  font-size: 38rpx;
  margin-left: 12rpx;
}

.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  padding: 100rpx 0;
}
