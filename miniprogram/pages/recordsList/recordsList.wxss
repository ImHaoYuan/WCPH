.page {
  min-height: 100vh;
  padding: 24rpx;
}

.rec-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.r-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex: 0 0 92rpx;
}

.r-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.r-title-line {
  display: flex;
  align-items: center;
}

.r-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  max-width: 320rpx;
}

.r-badge {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #E7F7EF;
  color: #2BB673;
  font-size: 20rpx;
}

.r-question {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 220rpx;
}

.r-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.r-arrow {
  color: var(--text-light);
  font-size: 38rpx;
  margin-left: 12rpx;
}

.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  padding: 100rpx 0;
}
