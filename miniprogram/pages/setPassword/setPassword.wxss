.page {
  min-height: 100vh;
  padding: 60rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #EEF2FF 0%, #F5F6FA 40%);
}

.header {
  padding: 30rpx 0 48rpx;
}

.title {
  color: var(--text-main);
  font-size: 44rpx;
  font-weight: 700;
}

.desc {
  margin-top: 14rpx;
  color: var(--text-sub);
  font-size: 26rpx;
}

.form {
  padding: 12rpx 32rpx;
}

.field {
  display: flex;
  align-items: center;
  height: 108rpx;
  border-bottom: 2rpx solid #F0F1F5;
}

.field:last-of-type {
  border-bottom: none;
}

.label {
  width: 150rpx;
  color: var(--text-sub);
  font-size: 28rpx;
}

.input {
  flex: 1;
  color: var(--text-main);
  font-size: 30rpx;
}

.ph {
  color: #C2C6D0;
}

.password-tip {
  margin-top: 24rpx;
  color: var(--text-light);
  font-size: 24rpx;
  line-height: 1.6;
}

.submit {
  width: 100%;
  margin-top: 48rpx;
}
