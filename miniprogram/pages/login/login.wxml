<view class="login">
  <view class="brand">
    <view class="logo">🐾</view>
    <view class="app-name">AI宠物助手</view>
    <view class="slogan">智能守护每一位毛孩子</view>
  </view>

  <button class="btn-primary wx-login" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">微信授权登录</button>

  <view class="divider">
    <view class="line"></view>
    <text class="divider-text">或使用以下方式登录</text>
    <view class="line"></view>
  </view>

  <!-- 登录方式切换 -->
  <view class="tabs card">
    <view class="tab {{loginTab === 'phone' ? 'active' : ''}}" data-tab="phone" bindtap="switchTab">手机号登录</view>
    <view class="tab {{loginTab === 'account' ? 'active' : ''}}" data-tab="account" bindtap="switchTab">账号密码登录</view>
  </view>

  <!-- 手机号登录 -->
  <view wx:if="{{loginTab === 'phone'}}" class="form card">
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="ph" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="field">
      <text class="label">验证码</text>
      <input class="input" type="number" maxlength="6" placeholder="请输入验证码" placeholder-class="ph" value="{{code}}" bindinput="onCodeInput" />
      <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="getCode">{{codeText}}</view>
    </view>
    <view class="remember" bindtap="toggleRemember">
      <view class="checkbox {{remember ? 'checked' : ''}}">{{remember ? '✓' : ''}}</view>
      <text class="remember-text">保存手机号以便下次快捷登录</text>
    </view>
  </view>

  <!-- 账号密码登录（账号由管理员创建） -->
  <view wx:else class="form card">
    <view class="field">
      <text class="label">账号</text>
      <input class="input" placeholder="请输入账号" placeholder-class="ph" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="请输入密码" placeholder-class="ph" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <view class="account-tip">没有账号？请联系管理员为您添加</view>
  </view>

  <button wx:if="{{loginTab === 'phone'}}" class="btn-primary submit" loading="{{saving}}" bindtap="doLogin">登录</button>
  <button wx:else class="btn-primary submit" loading="{{saving}}" bindtap="doAccountLogin">登录</button>

  <view wx:if="{{loginTab === 'phone'}}" class="demo-login" bindtap="demoLogin">演示登录（跳过验证）›</view>
  <view class="admin-login" bindtap="onAdminLogin">管理员登录 ›</view>
  <view class="agreement">登录即代表同意《用户协议》与《隐私政策》</view>
</view>
